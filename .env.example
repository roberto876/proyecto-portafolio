# =============================================================================
# Variables de entorno de la tienda
# =============================================================================
# PARA USARLA EN TU COMPUTADOR NO NECESITAS ESTE ARCHIVO: funciona sola.
#
# PARA PUBLICARLA NO LO COPIES A MANO: ejecuta
#     python manage.py preparar_produccion
# y el asistente te genera vercel-env.txt con todo listo para pegar en Vercel.
#
# Este archivo solo documenta TODAS las variables que existen. Si algún día
# necesitas una en tu computador, copia este archivo como `.env` (nunca se
# sube a GitHub) y completa lo que corresponda.
# =============================================================================

# --- Imprescindibles en Vercel (las genera el asistente) ----------------------
DJANGO_ENV=development
SECRET_KEY=
# Supabase > botón Connect > Transaction pooler (puerto 6543).
DATABASE_URL=
# Activa la tarea diaria que libera carritos abandonados.
CRON_SECRET=

# --- Pagos con Transbank Webpay Plus ------------------------------------------
# integration = pagos de prueba (sin dinero real). production = cobrar de verdad.
TRANSBANK_ENVIRONMENT=integration
# Solo para production: los entrega Transbank al contratar Webpay Plus.
# En integration se usan solos los códigos públicos de prueba.
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

# --- Dominio propio (opcional) --------------------------------------------------
# En Vercel el dominio xxx.vercel.app se reconoce solo. Si conectas un dominio
# propio, agrégalo aquí (sin https://), separado por comas si son varios.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SITE_URL=

# --- Correos (opcional pero recomendado) -----------------------------------------
# Sin esto no salen confirmaciones de compra ni avisos de venta.
# Ejemplo con Gmail (requiere «contraseña de aplicación», ver GUIA.md):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tutienda@gmail.com
# EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Tu Tienda <tutienda@gmail.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Subir fotos desde el panel (opcional) -------------------------------------
# Supabase > Project Settings > API Keys. Usa la clave SECRETA (service_role o
# sb_secret_...), NUNCA la pública. Crea antes un bucket público "productos".
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=productos

# --- Ajustes finos (normalmente no hace falta tocarlos) -------------------------
# Minutos que una orden sin pagar mantiene reservado su stock.
ORDER_RESERVATION_MINUTES=30
# Nivel de detalle del registro: DEBUG, INFO, WARNING o ERROR.
LOG_LEVEL=WARNING
# Valores iniciales de envío. Después se cambian en el panel (Ajustes de la tienda).
FREE_SHIPPING_THRESHOLD=60000
SHIPPING_COST=4990
